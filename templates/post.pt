<div metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="${post.excerpt}" />
    <meta property="og:url" content="${site.config.base_url}/${post.link}/" />
    <meta property="og:title" content="${post.title} | Manchester CoderDojo" />
    <meta property="og:description" content="${post.excerpt}" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1" tal:content="structure post.title"></div>

  <section metal:fill-slot="content">
    <article tal:attributes="class python:'post has-post-thumbnail hentry' if post.cover_image else 'post'">
      <div tal:condition="post.cover_image" class="post-thumbnail">
        <img src="/${post.link}/${post.cover_image}" alt="" />
      </div>
      <header class="entry-header">
        <div class="entry-meta">
          <span class="posted-on">Published <time datetime="${post.published.isoformat(timespec='seconds')}">${post.published.strftime("%-d %B %Y")}</time></span>
          <span tal:condition="post.modified_diff"> | Modified <time datetime="${post.modified.isoformat(timespec='seconds')}">${post.modified.strftime("%-d %B %Y")}</time></span>
          <span tal:condition="post.author"> | By ${post.author}</span>
        </div>
        <h1 class="entry-title" tal:content="structure post.title"></h1>
      </header>
      <div class="entry-content">
        <div tal:content="structure post.html"></div>
      </div>
    </article>
  </section>
</div>
