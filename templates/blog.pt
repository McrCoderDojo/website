<div metal:use-macro="layout" tal:define="body_extra_class string: full-width">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="Manchester CoderDojo blog" />
    <meta property="og:url" content="https://mcrcoderdojo.org.uk/blog/" />
    <meta property="og:title" content="Blog | Manchester CoderDojo" />
    <meta property="og:description" content="Manchester CoderDojo blog" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1">Blog</div>

  <section metal:fill-slot="content">
    <div class="hentry has-post-thumbnail">
      <div class="post-thumbnail">
        <img width="1024" height="576" src="/images/mcrcoderdojo-kit-1024x576.jpg" alt="" />
      </div>
      <div class="page-header">
        <h1 class="page-title">Blog</h1>
        <p>Our volunteer mentors (and young people) write blog posts about the ongoings with CoderDojo.</p>
      </div>
      <div class="entry-content full">
        <div class="grid-item" tal:repeat="post python:[p for p in posts if 'events' not in p.tags]">
          <tal:block tal:condition="post.cover_image">
            <a href="/${post.link}/"><img width="150" height="150" src="/${post.link}/images/${post.cover_image}" alt="" /></a>
          </tal:block>
          <tal:block tal:condition="not post.cover_image">
            <a href="/${post.link}/"><img width="150" height="150" src="/images/coderdojo.png" alt="" /></a>
          </tal:block>
          <h2><a href="/${post.link}/" tal:content="structure post.title"></a></h2>
          <span class="date">${post.published.strftime("%-d %B %Y")}</span>
          <tal:block tal:condition="post.author"><br /><span class="author">${post.author}</span></tal:block>
        </div>
      </div>
      <div class="entry-content">
        <nav>
          <ul>
            <li><a href="/blog/archive/">Archive</a></li>
            <li><a href="/blog/tags/">All tags</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </section>
</div>
