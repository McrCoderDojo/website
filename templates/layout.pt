<foo tal:omit-tag="1" metal:define-macro="layout"><!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <title>Manchester CoderDojo | <span metal:define-slot="title">A youth club to code &amp; make things</span></title>
  <link rel="icon" type="image/png" href="/images/coderdojo.png" />
  <link rel="profile" href="http://gmpg.org/xfn/11">
  <link rel="dns-prefetch" href="//fonts.googleapis.com" />
  <link rel="alternate" type="application/atom+xml" title="Manchester CoderDojo Feed" href="/posts/atom.xml" />
  <link rel="stylesheet" href="//fonts.googleapis.com/css?family=Lato%3A300%2C400%2C700%2C900%2C300italic%2C400italic%2C700italic" type="text/css" media="all" />
  <link rel="stylesheet" href="/genericons/genericons.css" type="text/css" media="all" />
  <link rel="stylesheet" href="/style.css" type="text/css" media="all" />
  <link rel="stylesheet" href="/block-library-style.min.css" type="text/css" media="all" />
  <style type="text/css" id="twentyfourteen-header-css">
    .site-title a {
      color: #ffffff;
    }
  </style>
  <style type="text/css" id="custom-background-css">
    body.custom-background { background-color: #000000; }
  </style>
  <link rel="stylesheet" href="/custom.css" type="text/css" />
  <meta metal:define-slot="head" />
</head>
<body class="custom-background full-width">
  <div id="page" class="hfeed site">
    <header id="masthead" class="site-header" role="banner">
      <div class="header-main">
        <h1 class="site-title"><a href="/" rel="home">Manchester CoderDojo</a></h1>
        <nav id="primary-navigation" class="site-navigation primary-navigation" role="navigation">
          <h1 class="menu-toggle">Primary Menu</h1>
          <a class="screen-reader-text skip-link" href="#content">Skip to content</a>
          <div class="menu-nav-bar-container">
            <ul id="menu-nav-bar" class="nav-menu">
              <li class="menu-item"><a href="/about/">About</a></li>
              <li class="menu-item"><a href="/posts/tags/events/">Events</a></li>
              <li class="menu-item"><a href="/posts/">Blog</a></li>
              <li class="menu-item"><a href="/volunteer-roles/">Volunteer Roles</a></li>
              <li class="menu-item"><a href="/venue/">How to find us</a></li>
              <li class="menu-item"><a href="/practicals/">Practicals</a></li>
              <li class="menu-item"><a href="/elsewhere/">Elsewhere</a></li>
              <li class="menu-item"><a href="http://eepurl.com/XWX49">Mailing List</a></li>
              <li class="menu-item"><a href="/contact-us/">Contact Us</a></li>
              <li class="menu-item"><a href="/support/">Support Us</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <div id="main" class="site-main">
      <div id="main-content" class="main-content">
        <div id="primary" class="content-area">
          <div id="content" class="site-content" role="main">
            <section metal:define-slot="content" />
          </div>
        </div>
      </div>

      <div id="secondary">
        <a href="/"><img src="/images/mcrcoderdojo.png" width="162" height="162" class="logo" alt="Manchester CoderDojo" /></a>
        <h2 class="site-description">A youth club to code &amp; make things</h2>
        <div id="primary-sidebar" class="primary-sidebar widget-area" role="complementary">
          <aside class="widget widget_custom_html">
            <h1 class="widget-title">Supported by</h1>
            <div class="textwidget custom-html-widget">
              <a href="/venue/"><img src="/ada.png" alt="Ada Manchester" /></a>
            </div>
          </aside>
          <aside class="widget widget_mcd_social_icons_widget">
            <h1 class="widget-title">Manchester CoderDojo on...</h1>
            <a href="http://www.facebook.com/McrCoderDojo" title="Facebook"><img src="/images/facebook-32x32.png" width="32" height="32" alt="Facebook" /></a>
            <a href="http://www.youtube.com/user/mcrcoderdojo" title="YouTube"><img src="/images/youtube-32x32.png" width="32" height="32" alt="YouTube" /></a>
            <a href="http://flickr.com/mcrcoderdojo" title="Flickr"><img src="/images/flickr-32x32.png" width="32" height="32" alt="Flickr" /></a>
            <a href="http://github.com/mcrcoderdojo" title="GitHub"><img src="/images/github-32x32.png" width="32" height="32" alt="GitHub" /></a>
          </aside>
          <aside class="widget widget_recent_entries">
            <h1 class="widget-title">Recent Posts</h1>
            <ul class="sidebar-recent-posts">
              <tal:block tal:repeat="rpost site.posts">
              <li tal:condition="'events' not in rpost.tags">
                <a href="/${rpost.link}/" tal:content="structure rpost.title"></a>
              </li>
              </tal:block>
            </ul>
          </aside>
        </div>
      </div>
    </div>

    <footer id="colophon" class="site-footer" role="contentinfo">
      <div class="site-info">
        Website generated by <a href="https://github.com/bennuttall/beemo">Beemo</a>.
        Theme available on <a href="http://github.com/mcrcoderdojo/website">GitHub</a>.
      </div>
    </footer>
  </div>

  <script src="/jquery.min.js"></script>
  <script src="/functions.js"></script>

</body>
</html>
</foo>
