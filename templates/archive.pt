<div metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="Manchester CoderDojo blog archive" />
    <meta property="og:url" content="https://mcrcoderdojo.org.uk/${link}/" />
    <meta property="og:title" content="${title} | Manchester CoderDojo" />
    <meta property="og:description" content="Manchester CoderDojo blog archive" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1">${title}</div>

  <section metal:fill-slot="content">
    <div class="page-header">
      <h1 class="page-title">${title}</h1>
    </div>
    <div class="entry-content">
      <div tal:repeat="(year, year_posts) archive.items()">
        <h2><a href="/blog/${year}/">${year}</a></h2>
        <ul>
          <li tal:repeat="post year_posts">
            <a href="/${post.link}" tal:content="structure post.title"></a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>
